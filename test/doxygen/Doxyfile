@INCLUDE               = doxygen-javascript.conf

PROJECT_NAME           = "javascript-doxygen integration"
OUTPUT_DIRECTORY       = test/doxygen/out
CREATE_SUBDIRS         = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
INPUT                  = test/doxygen/fixture.js
RECURSIVE              = NO
FILE_PATTERNS          = *.js
EXTENSION_MAPPING      = js=JavaScript
FILTER_PATTERNS        = *.js="$(AWK_BIN) -f $(DOXYGEN_JAVASCRIPT_FILTER) --"
FILTER_SOURCE_FILES    = YES
EXTRACT_ALL            = NO
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
