PROJECT_NAME           = "javascript-doxygen"
PROJECT_BRIEF          = "Reference documentation for javascript-doxygen"
OUTPUT_DIRECTORY       = doc/reference
CREATE_SUBDIRS         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = .
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
INPUT                  = README.md \
                         doxygen-javascript.awk \
                         test/run-tests.sh \
                         doc/adr \
                         doc/decisions.md \
                         doc/standards/javascript/documentation-standard.md
RECURSIVE              = YES
FILE_PATTERNS          = *.awk \
                         *.sh \
                         *.bash \
                         *.md
EXCLUDE                = vendor \
                         doc/reference \
                         doc/adr/templates
EXCLUDE_PATTERNS       = */vendor/* \
                         */doc/reference/* \
                         */doc/adr/templates/* \
                         */README.intro.md \
                         */README.outro.md
EXTENSION_MAPPING      = awk=C++ \
                         sh=C++ \
                         bash=C++
FILTER_PATTERNS        = *.awk=$(AWK_DOXYGEN_FILTER) \
                         *.sh=$(BASH_DOXYGEN_FILTER) \
                         *.bash=$(BASH_DOXYGEN_FILTER)
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = doc/adr/README.md
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
